<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\VipMilestoneMapperInterface;
use BrandBridge\DTOs\V1\Vip\VipMilestoneDTO;
use Illuminate\Database\DatabaseManager;

final class VipMilestoneMapper implements VipMilestoneMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    /** @return VipMilestoneDTO[] */
    public function mapAll(string $sourcePlayerId): array
    {
        $rows = $this->db->connection(config('brand-bridge.connection'))
            ->table('vip_milestones') // TODO: change to your VIP milestones table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->orderBy('achieved_at', 'desc') // TODO
            ->get();

        return $rows->map(fn (object $row) => new VipMilestoneDTO(
            milestoneId: (string) $row->id, // TODO
            title: $row->title, // TODO
            description: $row->description ?? null, // TODO
            achievedAt: $row->achieved_at ? new \DateTimeImmutable($row->achieved_at) : null, // TODO
            targetValue: isset($row->target_value) ? (float) $row->target_value : null, // TODO
            currentValue: isset($row->current_value) ? (float) $row->current_value : null, // TODO
        ))->all();
    }
}
