<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\VipReminderMapperInterface;
use BrandBridge\DTOs\V1\Vip\VipReminderDTO;
use Illuminate\Database\DatabaseManager;

final class VipReminderMapper implements VipReminderMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    /** @return VipReminderDTO[] */
    public function mapAll(string $sourcePlayerId): array
    {
        $rows = $this->db->connection(config('brand-bridge.connection'))
            ->table('vip_reminders') // TODO: change to your VIP reminders table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->orderBy('due_at', 'asc') // TODO
            ->get();

        return $rows->map(fn (object $row) => new VipReminderDTO(
            reminderId: (string) $row->id, // TODO
            title: $row->title, // TODO
            description: $row->description ?? null, // TODO
            dueAt: new \DateTimeImmutable($row->due_at), // TODO
            completedAt: $row->completed_at ? new \DateTimeImmutable($row->completed_at) : null, // TODO
            isCompleted: (bool) $row->is_completed, // TODO
        ))->all();
    }
}
