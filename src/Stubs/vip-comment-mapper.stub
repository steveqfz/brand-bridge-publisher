<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\VipCommentMapperInterface;
use BrandBridge\DTOs\V1\Vip\VipCommentDTO;
use Illuminate\Database\DatabaseManager;

final class VipCommentMapper implements VipCommentMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    /** @return VipCommentDTO[] */
    public function mapAll(string $sourcePlayerId): array
    {
        $rows = $this->db->connection(config('brand-bridge.connection'))
            ->table('vip_comments') // TODO: change to your VIP comments table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->orderBy('created_at', 'desc') // TODO
            ->get();

        return $rows->map(fn (object $row) => new VipCommentDTO(
            commentId: (string) $row->id, // TODO
            authorName: $row->author_name, // TODO
            content: $row->content, // TODO
            createdAt: new \DateTimeImmutable($row->created_at), // TODO
        ))->all();
    }
}
