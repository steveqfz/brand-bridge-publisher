<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\VipContactMapperInterface;
use BrandBridge\DTOs\V1\Vip\VipContactDTO;
use Illuminate\Database\DatabaseManager;

final class VipContactMapper implements VipContactMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    /** @return VipContactDTO[] */
    public function mapAll(string $sourcePlayerId): array
    {
        $rows = $this->db->connection(config('brand-bridge.connection'))
            ->table('vip_contacts') // TODO: change to your VIP contacts table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->orderBy('is_primary', 'desc') // TODO
            ->get();

        return $rows->map(fn (object $row) => new VipContactDTO(
            contactId: (string) $row->id, // TODO
            type: $row->type, // TODO
            value: $row->value, // TODO
            isPrimary: (bool) $row->is_primary, // TODO
            createdAt: new \DateTimeImmutable($row->created_at), // TODO
        ))->all();
    }
}
