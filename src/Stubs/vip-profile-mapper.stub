<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\VipProfileMapperInterface;
use BrandBridge\DTOs\V1\Vip\VipProfileDTO;
use BrandBridge\Enums\VipTier;
use Illuminate\Database\DatabaseManager;

final class VipProfileMapper implements VipProfileMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    public function map(string $sourcePlayerId): ?VipProfileDTO
    {
        $row = $this->db->connection(config('brand-bridge.connection'))
            ->table('vip_profiles') // TODO: change to your VIP profiles table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->first();

        if (!$row) {
            return null;
        }

        return new VipProfileDTO(
            tier: VipTier::from($row->tier), // TODO: map your tier values to VipTier enum
            points: (int) ($row->points ?? 0), // TODO
            lifetimePoints: (int) ($row->lifetime_points ?? 0), // TODO
            tierAchievedAt: $row->tier_achieved_at ? new \DateTimeImmutable($row->tier_achieved_at) : null, // TODO
            tierExpiresAt: $row->tier_expires_at ? new \DateTimeImmutable($row->tier_expires_at) : null, // TODO
            isRetained: (bool) ($row->is_retained ?? false), // TODO
        );
    }
}
