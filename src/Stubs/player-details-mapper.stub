<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\PlayerDetailsMapperInterface;
use BrandBridge\DTOs\V1\PlayerDetailsDTO;
use BrandBridge\Enums\PlayerStatus;
use Illuminate\Database\DatabaseManager;

final class PlayerDetailsMapper implements PlayerDetailsMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    public function map(string $sourcePlayerId): ?PlayerDetailsDTO
    {
        $row = $this->db->connection(config('brand-bridge.connection'))
            ->table('player_details') // TODO: change to your players table
            ->where('player_id', $sourcePlayerId) // TODO: change to your PK column
            ->first();

        if (!$row) {
            return null;
        }

        return new PlayerDetailsDTO(
            firstName: $row->first_name ?? null,
            lastName: $row->last_name ?? null,
            middleName: $row->middle_name ?? null,
            callingCode: $row->calling_code ?? null,
            contactNumber: $row->contact_number
                ?? $row->phone_number
                ?? $row->phone
                ?? null,
            birthday: isset($row->birthday)
                ? new \DateTimeImmutable($row->birthday)
                : (
                    isset($row->date_of_birth)
                        ? new \DateTimeImmutable($row->date_of_birth)
                        : null
                ),
            language: $row->language ?? null,
            address: $row->address ?? null,
            postCode: $row->post_code
                ?? $row->postal_code
                ?? null,
            nationality: $row->nationality
                ?? $row->country
                ?? null,
            gender: $row->gender ?? null,
            playerId: $row->player_id
                ?? $row->id
                ?? null,
            signupUrl: $row->signup_url ?? null,
            countryId: $row->country_id ?? null,
            stateId: $row->state_id ?? null,
            cityId: $row->city_id ?? null,
            payload: isset($row->payload)
                ? (array) json_decode((string) $row->payload, true)
                : null,
            registerFrom: $row->register_from ?? null,
            queryString: $row->query_string ?? null,
            stateName: $row->state_name
                ?? $row->region
                ?? null,
            cityName: $row->city_name
                ?? $row->city
                ?? null,
            timezone: $row->timezone ?? null,
            privateMode: (bool) ($row->private_mode ?? false),
            isPep: (bool) ($row->is_pep ?? false),
            hasSanctions: (bool) ($row->has_sanctions ?? false),
            customAttributes: isset($row->custom_attributes)
                ? (array) json_decode((string) $row->custom_attributes, true)
                : null,
            indicators: isset($row->indicators)
                ? (array) json_decode((string) $row->indicators, true)
                : null,
        );
    }
}
