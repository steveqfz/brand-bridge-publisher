<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\PlayerSnapshotMapperInterface;
use BrandBridge\DTOs\V1\PlayerSnapshot;
use BrandBridge\Enums\BrandKey;
use Illuminate\Database\DatabaseManager;
use BrandBridge\Enums\PlayerStatus;

final class PlayerSnapshotMapper implements PlayerSnapshotMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    public function map(string $sourcePlayerId): ?PlayerSnapshot
    {
        $row = $this->db->connection(config('brand-bridge.connection'))
            ->table('players') // TODO: change to your players table
            ->where('id', $sourcePlayerId) // TODO: change to your PK column
            ->first();

        if (!$row) {
            return null;
        }

        return new PlayerSnapshot(
            sourcePlayerId: (string) $row->id, // TODO
            sourceBrand: BrandKey::from(config('brand-bridge.brand_key')),
            vipSettingId: $row->vip_setting_id ?? null,
            username: (string) $row->username,
            email: (string) $row->email,
            password: $row->password ?? null,
            currencyCode: strtoupper((string) ($row->currency_code ?? $row->currency ?? 'USD')),
            status: PlayerStatus::from((string) $row->status),
            banned: (bool) ($row->banned ?? false),
            excluded: (bool) ($row->excluded ?? false),
            suspended: (bool) ($row->suspended ?? false),
            kickedAt: isset($row->kicked_at)
                ? new \DateTimeImmutable($row->kicked_at)
                : null,
            lastLoggedInAt: isset($row->last_logged_in_at)
                ? new \DateTimeImmutable($row->last_logged_in_at)
                : null,
            phoneVerifiedAt: isset($row->phone_verified_at)
                ? new \DateTimeImmutable($row->phone_verified_at)
                : null,
            betLimit: isset($row->bet_limit)
                ? (float) $row->bet_limit
                : null,
            isTestPlayer: (bool) ($row->is_test_player ?? false),
            agentCode: $row->agent_code ?? null,
            batchId: $row->batch_id ?? null,
            phoneNumber: $row->phone_number
                ?? $row->phone
                ?? null,
            isHoldWithdrawal: (bool) ($row->is_hold_withdrawal ?? false),
            uuid: (string) ($row->uuid ?? $row->id),
            lastOnlineAt: isset($row->last_online_at)
                ? new \DateTimeImmutable($row->last_online_at)
                : null,
            lastOfflineAt: isset($row->last_offline_at)
                ? new \DateTimeImmutable($row->last_offline_at)
                : null,
            referredById: isset($row->referred_by_id)
                ? (int) $row->referred_by_id
                : null,
            referredByCode: $row->referred_by_code ?? null,
            referredOrderNumber: $row->referred_order_number ?? null,
            preferredCurrency: $row->preferred_currency ?? null,
            passwordInitiated: (bool) ($row->password_initiated ?? false),
            vipRewardSettingId: isset($row->vip_reward_setting_id)
                ? (int) $row->vip_reward_setting_id
                : null,
            globalId: $row->global_id ?? null,
        );
    }
}
