<?php

declare(strict_types=1);

namespace App\BrandBridge\Mappers;

use BrandBridge\Contracts\Mappers\OauthPlayersMapperInterface;
use BrandBridge\DTOs\V1\PlayerTagDTO;
use Illuminate\Database\DatabaseManager;

final class OauthPlayersMapper implements OauthPlayersMapperInterface
{
    public function __construct(
        private readonly DatabaseManager $db,
    ) {}

    /** @return PlayerTagDTO[] */
    public function mapAll(string $sourcePlayerId): array
    {
        $rows = $this->db->connection(config('brand-bridge.connection'))
            ->table('oauth_players') // TODO: change to your tags table
            ->where('player_id', $sourcePlayerId) // TODO: change to your FK column
            ->get();

        return $rows->map(fn (object $row) => new PlayerTagDTO(
            playerId: $row->player_id, // TODO
            providerPlayerId: $row->provider_player_id, // TODO
            provider: $this->provider, // TODO
            meta: $row->meta ?? [], // TODO
        ))->all();
    }
}