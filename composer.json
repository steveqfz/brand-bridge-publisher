{
  "name": "terragon/brand-bridge-publisher",
  "description": "Brand Bridge — DTOs and Laravel publisher infrastructure for cross-brand player onboarding",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/http": "^10.0|^11.0",
    "illuminate/routing": "^10.0|^11.0",
    "illuminate/database": "^10.0|^11.0"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^1.10",
    "orchestra/testbench": "^8.0|^9.0"
  },
  "autoload": {
    "psr-4": { "BrandBridge\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "BrandBridge\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["BrandBridge\\BrandBridgeServiceProvider"]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
